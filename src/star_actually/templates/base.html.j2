<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page_title }}</title>
<link rel="stylesheet" href="{{ site.base_path }}/assets/style.css">
</head>
<body data-base="{{ site.base_path }}">
<header class="site-head">
  <a class="site-name" href="{{ site.base_path }}/">{{ site.title }}</a>
  <span class="site-tagline">{{ site.tagline }}</span>
  {%- if site.chains %}
  {# A chain is fixed structure, not a place you happen to be — so it lives in
     the chrome, reachable from every node, not only from its own members. #}
  <nav class="head-chains" aria-label="chains">
    {%- for c in site.chains %}
    <a class="head-chain" href="{{ site.base_path }}/c/{{ c.id }}/"
       hx-get="{{ site.base_path }}/c/{{ c.id }}.html" hx-target="#content" hx-swap="outerHTML"
       hx-push-url="{{ site.base_path }}/c/{{ c.id }}/">&equiv; {{ c.title }} &middot; {{ c.nodes | length }}</a>
    {%- endfor %}
  </nav>
  {%- endif %}
</header>

<div class="rail" id="rail" aria-label="your path"></div>

<main class="reading">
{{ content | safe }}
</main>

{# The bar advertises the same keys everywhere so nothing moves between pages,
   but a key that does nothing here renders dimmed — the fixed-slot discipline
   the depth dial and the chain strip already follow. `dead_keys` comes from the
   renderer, which knows what kind of page this is; the reader never has to
   press a key to discover it was inert. #}
{%- set dead = dead_keys | default(()) -%}
<footer class="action-bar" id="action-bar">
  {%- for key, glyph, label in [
      ('back', '&uarr;', 'back'),
      ('onward', '&darr;', 'onward'),
      ('deeper', '&minus;', 'deeper'),
      ('surface', '+', 'surface'),
      ('branch', '&rarr;', 'branch'),
      ('return', '&crarr;', 'return')] %}
  <span class="key-hint{% if key in dead %} is-disabled{% endif %}"><kbd>{{ glyph | safe }}</kbd> {{ label }}</span>
  {%- endfor %}
  <span class="key-hint"><a href="{{ site.base_path }}/"><kbd>/</kbd> search</a></span>
  <span class="key-hint"><a href="{{ site.base_path }}/help.html"><kbd>?</kbd> help</a></span>
</footer>

<script src="{{ site.base_path }}/assets/htmx.min.js"></script>
<script src="{{ site.base_path }}/assets/app.js"></script>
</body>
</html>
